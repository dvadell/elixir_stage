<Layouts.app flash={@flash} show_header={false}>
  <div data-stt-settings>
    <h1 class="text-2xl font-bold tracking-tight">{gettext("Voice assistant settings")}</h1>
    <p class="mt-2 max-w-xl text-base-content/70">
      {gettext(
        "Choose the speech-to-text model and text-to-speech engine the voice assistant uses."
      )}
    </p>

    <div class="mt-8 rounded-box border border-base-300 bg-base-100 p-6 shadow-sm">
      <label for="stt-model" class="mb-2 block text-sm font-semibold">
        {gettext("STT model")}
      </label>
      <select
        id="stt-model"
        data-stt-model
        class="w-full cursor-pointer rounded-lg border border-base-300 bg-base-100 px-4 py-2.5 text-sm font-medium transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30"
      >
        <option
          :for={{id, label, desc} <- models()}
          value={id}
          data-label={label}
          data-desc={desc}
        >
          {label}
        </option>
      </select>

      <p id="stt-model-desc" class="mt-3 text-sm text-base-content/60" hidden></p>

      <p class="mt-3 text-sm text-base-content/60">
        {gettext(
          "Applies the next time you open the voice assistant; the model is downloaded on first use."
        )}
      </p>

      <div
        id="stt-saved"
        class="mt-4 flex items-center gap-2 rounded-lg bg-success/10 px-4 py-3 text-sm font-medium text-success"
        hidden
      >
        <.icon name="hero-check-circle" class="size-4 shrink-0" />
        <span id="stt-saved-text"></span>
      </div>
    </div>

    <div class="mt-8 rounded-box border border-base-300 bg-base-100 p-6 shadow-sm">
      <label for="tts-model" class="mb-2 block text-sm font-semibold">
        {gettext("Text-to-speech engine")}
      </label>
      <select
        id="tts-model"
        data-tts-model
        class="w-full cursor-pointer rounded-lg border border-base-300 bg-base-100 px-4 py-2.5 text-sm font-medium transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30"
      >
        <option
          :for={{id, label, desc} <- tts_models()}
          value={id}
          data-label={label}
          data-desc={desc}
        >
          {label}
        </option>
      </select>

      <p id="tts-model-desc" class="mt-3 text-sm text-base-content/60" hidden></p>

      <p class="mt-3 text-sm text-base-content/60">
        {gettext(
          "Applies the next time you open the voice assistant. Local models are downloaded on first use."
        )}
      </p>

      <div
        id="tts-saved"
        class="mt-4 flex items-center gap-2 rounded-lg bg-success/10 px-4 py-3 text-sm font-medium text-success"
        hidden
      >
        <.icon name="hero-check-circle" class="size-4 shrink-0" />
        <span id="tts-saved-text"></span>
      </div>
    </div>

    <div class="mt-6 text-sm text-base-content/60">
      <a
        href={~p"/"}
        class="inline-flex items-center gap-2 rounded-lg px-3 py-2 font-medium transition hover:bg-base-300/60 hover:text-base-content"
      >
        <.icon name="hero-arrow-left" class="size-4" />
        {gettext("Back to the voice assistant")}
      </a>
    </div>
  </div>
</Layouts.app>
